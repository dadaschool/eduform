# 이 파일을 복사해 .env.local 로 만들고 실제 값을 채우세요.
#   cp .env.example .env.local
#
# 같은 값 4개를 Vercel 프로젝트 설정 > Environment Variables 에도 등록해야
# 배포가 성공합니다. 자세한 순서는 SETUP.md 참고.

# Supabase 대시보드 > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# 같은 화면 > Project API keys > anon / public
# 브라우저에 노출되는 공개 키입니다. RLS 로 보호됩니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 같은 화면 > Project API keys > service_role
# RLS 를 무시하는 관리자 키입니다. 절대 클라이언트 코드나 깃에 넣지 마세요.
# 학생 계정 생성 / 비밀번호 초기화 API 에서만 서버 측으로 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (aistudio.google.com/app/apikey) 에서 발급
# 평가 문구 생성 / 생활기록부 초안 생성에 사용합니다.
GEMINI_API_KEY=
