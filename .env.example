# 이 파일을 복사해 .env.local 로 만들고 실제 값을 채우세요.
#   cp .env.example .env.local
#
# 같은 값 4개를 Vercel 프로젝트 설정 > Environment Variables 에도 등록해야
# 배포가 성공합니다. 자세한 순서는 SETUP.md 참고.

# Supabase 대시보드 > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# 같은 화면 > Project API keys > anon / public
# 브라우저에 노출되는 공개 키입니다. RLS 로 보호됩니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 같은 화면 > Project API keys > service_role
# RLS 를 무시하는 관리자 키입니다. 절대 클라이언트 코드나 깃에 넣지 마세요.
# 학생 계정 생성 / 비밀번호 초기화 API 에서만 서버 측으로 사용합니다.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (평가 항목 추천 / 생활기록부 초안 생성) ---
# AI 는 교사가 로그인 후 «내 계정 → AI API 키» 에서 자기 키(업스테이지 / Gemini /
# OpenAI)를 1개 이상 등록해 씁니다. 등록 순서대로 시도하고, 한 곳에서 할당량이
# 바닥나거나 오류가 나면 다음 키로 넘어갑니다. 유료 제공자(지금은 OpenAI, 2027-05
# 이후 업스테이지)로 «조용히» 넘어가지는 않고 화면이 한 번 확인을 묻습니다.
#    (자세한 내용은 SETUP.md 의 [AI: 교사별 API 키])

# 교사가 등록한 키를 DB 에 넣을 때 AES-256-GCM 으로 암호화하는 열쇠입니다.
# 32자 이상 임의 문자열. 예: node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
# 이 값을 잃어버리거나 바꾸면 교사들이 등록한 키를 다시 넣어야 합니다.
AI_KEY_SECRET=

# 아래 세 칸은 «관리자 계정 전용» 학교 공용 폴백입니다 (선택).
# 관리자가 자기 키를 등록하지 않아도 점검·시연용으로 쓸 수 있게만 열어 둡니다.
# 일반 교사에게는 적용되지 않습니다. 비워 두면 관리자도 «내 계정» 에서 등록해야 합니다.
GEMINI_API_KEY=
UPSTAGE_API_KEY=
OPENAI_API_KEY=

# 확인 창 없이 늘 유료를 쓰겠다면 1 로 둡니다. 기본은 꺼짐.
# 🔴 이 값을 켜면 «모르는 사이의 과금» 을 막는 마지막 문이 열립니다. 정말 필요할 때만.
AI_ALLOW_PAID=

# --- 설치용 (선택) ---
# npm run db:setup / db:seed 로 테이블을 자동 생성할 때만 필요합니다.
# Supabase > Project Settings > Database > Connection string > URI 를 복사하고
# [YOUR-PASSWORD] 를 실제 DB 비밀번호로 바꾸세요.
# 앱 실행에는 필요 없고, Vercel 에는 등록하지 않아도 됩니다.
# 비밀번호에 @ : / 가 있으면 URL 인코딩이 필요합니다 (@ 는 %40).
SUPABASE_DB_URL=
